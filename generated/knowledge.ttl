<urn:sumidashi:principle:mdl.single-source-of-knowledge> a sd:Principle ;
    sd:citedFrom <urn:sumidashi:source:hunt-thomas-1999> ;
    sd:identifier "mdl.single-source-of-knowledge" ;
    sd:statement "同じ業務知識（概念・計算・ルール）は、1つのコンテキストの中で1か所にだけ表す" .

