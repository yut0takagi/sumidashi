<urn:sumidashi:principle:ca.dependency-rule> a sd:Principle ;
    sd:citedFrom <urn:sumidashi:source:martin-2017> ;
    sd:identifier "ca.dependency-rule" ;
    sd:statement "ソースコードの依存は内側の方針へだけ向け、内側の層は外側の層の名前を一切知らない" .

